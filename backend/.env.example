# ===== INFINITY AI settings. Copy this file to .env, fill in, save. Never share .env. =====

# --- AI keys: add ONE or MORE. The app tries them in order and automatically
# --- falls back to the next one if a provider fails or hits its limit.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=AIza-AQ.Ab8RN6Le6rZdptarRoHk9a_LrdAC7Mm6O7if9GDvCrJ39ySD3Q
OPENROUTER_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force the order, e.g.  AI_PROVIDERS=groq,gemini,openrouter   (add "ollama" for a local model)
AI_PROVIDERS=groq,ollama
# Optional: change a model if a provider retires one, e.g.
# GROQ_MODEL=openai/gpt-oss-120b
# # Providers to use (only Groq, since that's the key you have)
AI_PROVIDERS=groq

# Groq model
GROQ_MODEL=openai/gpt-oss-120b

# --- "Continue with Gmail" (optional)
GOOGLE_CLIENT_ID=494174608125-pg1617c0ahibflph1gbetnm80klbmia1.apps.googleusercontent.com

